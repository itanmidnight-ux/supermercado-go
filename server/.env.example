# ═══════════════════════════════════════════════════════════════
# SupermercadosGo — Environment Variables
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=3777
HOST=0.0.0.0

# Security — OBLIGATORIOS (no hay valores por defecto)
JWT_SECRET=generate-a-strong-random-secret-here-min-32-chars
API_KEY=generate-a-strong-random-api-key-here-min-32-chars

# Database
DB_PATH=./data/supermercados.db

# CORS — orígenes permitidos separados por coma (no usar * en producción)
CORS_ORIGINS=http://localhost:3777

# Business data
BUSINESS_NAME=Supermercados Go
BUSINESS_PHONE=+57XXXXXXXXXX
BUSINESS_EMAIL=contacto@tudominio.com
BUSINESS_ADDRESS=Dirección del negocio
BUSINESS_CITY=Cúcuta
BUSINESS_DEPARTMENT=Norte de Santander
BUSINESS_HOURS=6:00 AM - 9:00 PM
BUSINESS_TAGLINE=Tu supermercado a la puerta de tu casa

# Delivery
DELIVERY_FEE_DEFAULT=4900
FREE_DELIVERY_MIN=50000
OPERATING_ZONE=Cúcuta

# SMTP (opcional — vacío = no enviar correos)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp (opcional)
WA_ENABLED=false
WA_BUSINESS_NUMBER=
WA_VERIFY_TOKEN=
WA_ACCESS_TOKEN=
WA_PHONE_ID=
